<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/history_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:orientation="vertical">

    <TextView
      android:id="@+id/history_detail_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/c3_history_details"
      android:textSize="18sp" />

    <include
      android:id="@+id/history_detail_event"
      layout="@layout/item_caregiver_overview_event" />

    <TextView
      android:id="@+id/history_instructions"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/history_close_details"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/c3_history_close_details" />
  </LinearLayout>
