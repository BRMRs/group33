<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/group33_screen_padding">

    <TextView
      android:id="@+id/overview_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/c3_overview_title"
      android:textAppearance="@style/TextAppearance.Group33.Title" />

    <TextView
      android:id="@+id/elder_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_medium"
      android:textAppearance="@style/TextAppearance.Group33.Body" />

    <TextView
      android:id="@+id/date_range"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_small"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <TextView
      android:id="@+id/state_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_medium"
      android:accessibilityLiveRegion="polite"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <TextView
      android:id="@+id/refresh_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_small"
      android:accessibilityLiveRegion="polite"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <TextView
      android:id="@+id/freshness"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_small"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <TextView
      android:id="@+id/last_sync"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_small"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <TextView
      android:id="@+id/capability"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_small"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <TextView
      android:id="@+id/capability_details"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_small"
      android:textAppearance="@style/TextAppearance.Group33.Supporting" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/refresh_button"
      style="@style/Widget.Group33.PrimaryAction"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/group33_spacing_medium"
      android:text="@string/c3_refresh" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/history_button"
      style="@style/Widget.Group33.SecondaryAction"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/c3_history" />

    <LinearLayout
      android:id="@+id/event_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
