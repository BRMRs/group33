<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caregiver_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/group33_screen_padding">

        <TextView
            android:id="@+id/caregiver_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/caregiver_navigation_title"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <TextView
            android:id="@+id/demo_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/caregiver_navigation_demo"
            android:textAppearance="@style/TextAppearance.Group33.Supporting"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/caregiver_current_elder"
            android:textAppearance="@style/TextAppearance.Group33.Supporting" />

        <TextView
            android:id="@+id/current_elder_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/caregiver_no_current_elder"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <TextView
            android:id="@+id/current_elder_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/caregiver_context_unavailable"
            android:textAppearance="@style/TextAppearance.Group33.Supporting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_button"
            style="@style/Widget.Group33.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/caregiver_home_nav"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/caregiver_home_title"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <TextView
            android:id="@+id/page_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/caregiver_home_intro"
            android:textAppearance="@style/TextAppearance.Group33.Body" />

        <LinearLayout
            android:id="@+id/navigation_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plans_button"
                style="@style/Widget.Group33.PrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/caregiver_plans_title"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/records_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/caregiver_records_title"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/caregiver_settings_title"
                android:textSize="18sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/language_button"
            style="@style/Widget.Group33.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/language_english"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
