<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/history_calendar_from" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/history_calendar_through" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/history_calendar_month" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceTitleMedium" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/history_calendar_previous" style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
        android:singleLine="false" android:maxLines="3" android:ellipsize="none" android:text="@string/c3_history_previous_month" />
      <com.google.android.material.button.MaterialButton android:id="@+id/history_calendar_next" style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
        android:singleLine="false" android:maxLines="3" android:ellipsize="none" android:text="@string/c3_history_next_month" />
    </LinearLayout>
    <TextView android:id="@+id/history_calendar_scroll_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:textSize="14sp" android:text="@string/c3_history_scroll_calendar" />
    <HorizontalScrollView android:id="@+id/history_calendar_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
      <GridLayout android:id="@+id/history_calendar_grid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:columnCount="7" />
    </HorizontalScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/history_dialog_confirm"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
      android:minHeight="48dp" android:singleLine="false" android:ellipsize="none" android:text="@string/c3_history_use_dates" />
    <com.google.android.material.button.MaterialButton android:id="@+id/history_dialog_cancel" style="?attr/materialButtonOutlinedStyle"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
      android:minHeight="48dp" android:singleLine="false" android:ellipsize="none" android:text="@string/c3_history_cancel_dates" />
  </LinearLayout>
</ScrollView>
