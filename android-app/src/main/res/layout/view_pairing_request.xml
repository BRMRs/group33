<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/pairing_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/group33_screen_padding">

        <TextView
            android:id="@+id/pairing_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_request_title"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pairing_request_intro"
            android:textAppearance="@style/TextAppearance.Group33.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pairing_code_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="@string/pairing_code_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pairing_code_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLength="8"
                android:minHeight="64dp"
                android:singleLine="true"
                android:textSize="24sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_submit_button"
            style="@style/Widget.Group33.PrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pairing_submit"
            android:textSize="20sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pairing_notice_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/group33_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/pairing_notice_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Group33.Title" />

                <TextView
                    android:id="@+id/pairing_notice_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Group33.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/pairing_requests_title"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_refresh_button"
            style="@style/Widget.Group33.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pairing_refresh"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/pairing_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pairing_requests_empty"
            android:textAppearance="@style/TextAppearance.Group33.Body" />

        <LinearLayout
            android:id="@+id/pairing_requests_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
