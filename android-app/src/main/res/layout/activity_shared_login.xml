<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="@dimen/group33_screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/language_button"
            style="@style/Widget.Group33.LanguageAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minWidth="@dimen/group33_touch_min_height"
            android:minHeight="@dimen/group33_touch_min_height"
            android:text="@string/language_english"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="@string/login_title"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/login_description"
            android:textAppearance="@style/TextAppearance.Group33.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/one_tap_button"
            style="@style/Widget.Group33.PrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/login_one_tap"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sms_button"
            style="@style/Widget.Group33.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_sms"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_preview_notice"
            android:textAppearance="@style/TextAppearance.Group33.Supporting" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
