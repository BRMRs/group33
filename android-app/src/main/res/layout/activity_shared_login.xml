<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/login_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/group33_screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/language_button"
            style="@style/Widget.Group33.SecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minWidth="@dimen/group33_language_button_min_width"
            android:minHeight="64dp"
            android:text="@string/language_english"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group33_title_top_margin"
            android:text="@string/login_title"
            android:textAppearance="@style/TextAppearance.Group33.Title" />

        <ProgressBar
            android:id="@+id/login_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/login_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/one_tap_button"
                style="@style/Widget.Group33.PrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/group33_primary_top_margin"
                android:minHeight="80dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/login_one_tap"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/choice_feedback_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                app:cardBackgroundColor="@color/group33_error_container"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/group33_error_outline"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/choice_feedback_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Group33.ErrorTitle" />
                    <TextView
                        android:id="@+id/choice_feedback_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.Group33.ErrorBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/other_methods_button"
                style="@style/Widget.Group33.LanguageAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/group33_touch_min_height"
                android:text="@string/login_other_methods"
            android:textSize="18sp"
            android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/alternative_methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sms_button"
                    style="@style/Widget.Group33.SecondaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_sms"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/password_button"
                    style="@style/Widget.Group33.SecondaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/login_password"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/login_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_to_methods_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="56dp"
                android:contentDescription="@string/login_back_to_methods"
                android:drawablePadding="8dp"
                app:icon="@drawable/ic_arrow_back_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/group33_action"
                android:text="@string/login_back_button_label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/form_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_sms"
                android:textAppearance="@style/TextAppearance.Group33.Title" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/login_phone_number">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:inputType="phone"
                    android:imeOptions="actionDone"
                    android:minHeight="80dp"
                    android:saveEnabled="false"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/code_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/login_verification_code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/code_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:minHeight="@dimen/group33_touch_min_height"
                    android:saveEnabled="false"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/request_code_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_request_code"
                android:textSize="18sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/login_password_field"
                android:visibility="gone"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:minHeight="@dimen/group33_touch_min_height"
                    android:saveEnabled="false"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forgot_password_button"
                style="@style/Widget.Group33.LanguageAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="@dimen/group33_touch_min_height"
                android:text="@string/login_forgot_password"
                android:textSize="18sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/new_password_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/login_new_password"
                android:visibility="gone"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/new_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:minHeight="@dimen/group33_touch_min_height"
                    android:saveEnabled="false"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/form_submit_button"
                style="@style/Widget.Group33.PrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="80dp"
                android:text="@string/login_sms"
                android:textSize="24sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/form_feedback_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                app:cardBackgroundColor="@color/group33_error_container"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/group33_error_outline"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/form_feedback_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Group33.ErrorTitle" />
                    <TextView
                        android:id="@+id/form_feedback_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.Group33.ErrorBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/login_choose_role"
                android:textAppearance="@style/TextAppearance.Group33.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_role_once"
                android:textAppearance="@style/TextAppearance.Group33.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_elder_button"
                style="@style/Widget.Group33.PrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="64dp"
                android:text="@string/elder_role"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_caregiver_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="64dp"
                android:text="@string/caregiver_role"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_registration_button"
                style="@style/Widget.Group33.LanguageAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/group33_touch_min_height"
                android:text="@string/login_back_to_methods" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/caregiver_registration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/login_caregiver_details"
                android:textAppearance="@style/TextAppearance.Group33.Title" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/login_display_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/display_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    android:minHeight="@dimen/group33_touch_min_height"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/registration_password_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/login_optional_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/registration_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:minHeight="@dimen/group33_touch_min_height"
                    android:saveEnabled="false"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/complete_registration_button"
                style="@style/Widget.Group33.PrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="64dp"
                android:text="@string/login_complete_registration"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip_password_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/login_skip_password"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_to_role_button"
                style="@style/Widget.Group33.LanguageAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/group33_touch_min_height"
                android:text="@string/login_back_to_role" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/signed_in_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/signed_in_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textAppearance="@style/TextAppearance.Group33.Title" />

            <TextView
                android:id="@+id/signed_in_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_demo_no_real_session"
                android:textAppearance="@style/TextAppearance.Group33.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_home_button"
                style="@style/Widget.Group33.PrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="64dp"
                android:text="@string/login_open_home_preview"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sign_out_button"
                style="@style/Widget.Group33.SecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_sign_out" />
        </LinearLayout>

        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Group33.Body"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/caregiver_navigation_preview_button"
            style="@style/Widget.Group33.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="@dimen/group33_touch_min_height"
            android:text="@string/caregiver_navigation_preview_action"
            android:visibility="gone" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
