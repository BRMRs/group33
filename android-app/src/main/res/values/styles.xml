<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Group33.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/group33_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.Group33.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/group33_text_secondary</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.Group33.Supporting" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/group33_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Group33.PrimaryAction" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/group33_action_min_height</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/group33_action</item>
    </style>
    <style name="Widget.Group33.SecondaryAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/group33_action_min_height</item>
        <item name="android:textColor">@color/group33_action</item>
    </style>
    <style name="Widget.Group33.LanguageAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/group33_action</item>
    </style>
</resources>
