<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Group33.Elder.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/group33_elder_title_text</item>
        <item name="android:textColor">@color/group33_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Group33.Elder.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/group33_elder_supporting_text</item>
        <item name="android:textColor">@color/group33_text_secondary</item>
    </style>

    <style name="TextAppearance.Group33.Elder.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/group33_elder_body_text</item>
        <item name="android:textColor">@color/group33_text_primary</item>
    </style>

    <style name="TextAppearance.Group33.Elder.Emphasis" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/group33_elder_emphasis_text</item>
        <item name="android:textColor">@color/group33_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Group33.Elder.Time" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/group33_elder_time_text</item>
        <item name="android:textColor">@color/group33_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Group33.Elder.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/group33_elder_primary_action_min</item>
        <item name="android:textSize">@dimen/group33_elder_body_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/group33_primary</item>
        <item name="android:textColor">@color/group33_on_primary</item>
        <item name="cornerRadius">@dimen/group33_corner_md</item>
    </style>

    <style name="Widget.Group33.Elder.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/group33_elder_touch_min</item>
        <item name="android:textSize">@dimen/group33_elder_body_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/group33_primary</item>
        <item name="android:textColor">@color/group33_primary</item>
        <item name="cornerRadius">@dimen/group33_corner_md</item>
    </style>

    <style name="Widget.Group33.Elder.DueCard" parent="">
        <item name="android:background">@drawable/bg_elder_due_card</item>
        <item name="android:padding">@dimen/group33_space_lg</item>
    </style>
</resources>
