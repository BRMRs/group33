<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:name=".integration.DebugChainApplication" android:usesCleartextTraffic="true" tools:replace="android:name">
        <activity android:name=".caregiver.plan.PlanEditorDebugActivity" android:exported="false" />
        <activity android:name=".caregiver.CaregiverNavigationPreviewActivity" android:exported="true" />
        <activity android:name=".caregiver.CaregiverEventRowTestActivity" android:exported="false" />
        <activity android:name=".caregiver.CaregiverHistoryTestActivity" android:exported="false" />
        <activity
            android:name=".caregiver.CaregiverOverviewTestActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:label="C3 Overview Preview (Debug)" />
        <receiver android:name=".integration.DebugDoseAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
