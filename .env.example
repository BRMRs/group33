# Explicit local-only PostgreSQL runtime. Keep actual values outside Git and shell command arguments.
# memory (default), postgres-local, or explicit postgres-supabase
PERSISTENCE_MODE=memory
# jdbc:postgresql://127.0.0.1:<local-port>/<database>; no URL-embedded credentials/query
PERSISTENCE_JDBC_URL=
# Existing initialized schema matching [a-z][a-z0-9_]{0,62}
PERSISTENCE_SCHEMA=
# Private database login values
PERSISTENCE_USERNAME=
PERSISTENCE_PASSWORD=
# Absolute path to a private owner-only regular file containing exactly 32 binary bytes
PERSISTENCE_RECEIPT_KEY_FILE=
# Stable private signing material, at least 32 UTF-8 bytes; development placeholder is rejected in postgres-local
JWT_SECRET=

# Local photo candidate only; private existing parent required. Business file limit is 5 MiB.
PHOTO_ENABLED=false
PHOTO_OBJECT_ROOT=

# Initial plan confirmation and reads; requires PHOTO_ENABLED=true and explicit v1-v7 initialization in postgres-local.
PLAN_ENABLED=false

# Cloud test runtime: see docs/SUPABASE_TEST_SETUP.md. Never put actual secrets in this file.
# Local fallback keeps postgres-local + local-file and never reads these cloud settings.
SUPABASE_PROJECT_REF=
# Cloud JDBC URL has no credentials/options, port 5432, database postgres (direct or shared session pooler).
# sslmode=verify-full is forced by code, with this downloaded project CA file.
PERSISTENCE_SSL_ROOT_CERT=
PHOTO_STORAGE_MODE=local-file
SUPABASE_STORAGE_ORIGIN=
SUPABASE_STORAGE_BUCKET=
# Owner-only file containing an sb_secret_ key; never use a mobile/publishable key here.
SUPABASE_STORAGE_SECRET_KEY_FILE=
SUPABASE_STORAGE_REQUEST_BUDGET_MS=30000
