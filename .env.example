# Explicit PostgreSQL runtime. Keep actual values outside Git and shell command arguments.
# memory (default), postgres-local, or reviewed postgres-supabase opt-in
PERSISTENCE_MODE=memory
# jdbc:postgresql://127.0.0.1:<local-port>/<database>; no URL-embedded credentials/query
PERSISTENCE_JDBC_URL=
# Existing initialized schema matching [a-z][a-z0-9_]{0,62}
PERSISTENCE_SCHEMA=
# Private database login values
PERSISTENCE_USERNAME=
PERSISTENCE_PASSWORD=
# Absolute path to a private owner-only regular file containing exactly 32 binary bytes
PERSISTENCE_RECEIPT_KEY_FILE=
# Stable private signing material, at least 32 UTF-8 bytes; development placeholder is rejected in postgres-local
JWT_SECRET=

# Local photo candidate only; private existing parent required. Business file limit is 5 MiB.
PHOTO_ENABLED=false
PHOTO_OBJECT_ROOT=

# Initial plan confirmation and reads; requires PHOTO_ENABLED=true and explicit v1-v7 initialization in postgres-local.
PLAN_ENABLED=false

# Existing occurrence-registration route only; requires PLAN_ENABLED=true and PHOTO_ENABLED=true.
# postgres-local additionally requires explicit prototype v1-v9 installation; never applies DDL at startup.
OCCURRENCE_ENABLED=false

# Isolated Supabase opt-in; local fallback does not read these settings.
# Cloud endpoints require direct/session port5432 and verified TLS with project CA.
SUPABASE_PROJECT_REF=
PERSISTENCE_SSL_ROOT_CERT=
PHOTO_STORAGE_MODE=local-file
SUPABASE_STORAGE_ORIGIN=
SUPABASE_STORAGE_BUCKET=
# Owner-only absolute regular file containing backend sb_secret_ material; never use in Android.
SUPABASE_STORAGE_SECRET_KEY_FILE=
SUPABASE_STORAGE_REQUEST_BUDGET_MS=30000
# Dose groups require occurrence, plan and photo runtime; default disabled.
DOSE_GROUP_ENABLED=false
# Optional read-only startup validation for the matching release in postgres-local/postgres-supabase.
# Render uses this canonical property inside private settings; memory with true is rejected.
PERSISTENCE_REQUIRE_VERSIONED_SCHEMA=false

# Bound phone candidate: separate from legacy PHONE_AUTH_ENABLED; not whole #118 acceptance.
# Requires explicit PostgreSQL, exact versioned release, independent keys and verified proxy chain.
PHONE_AUTH_ENABLED=false
BOUND_PHONE_AUTH_ENABLED=false
BOUND_PHONE_JWT_KEY_FILE=
BOUND_PHONE_HASH_KEY_FILE=
BOUND_PHONE_JWT_ISSUER=
BOUND_PHONE_JWT_AUDIENCE=
BOUND_PHONE_ACCESS_KEY_ID=
BOUND_PHONE_ACCESS_KEY_SECRET=
BOUND_PHONE_SCHEME_CODE=
BOUND_PHONE_ANDROID_PACKAGE=
BOUND_PHONE_ANDROID_SIGNATURE=
BOUND_PHONE_TRUSTED_PROXY_CIDRS=
BOUND_PHONE_SESSION_SECONDS=86400
BOUND_PHONE_CLOCK_ALLOWANCE_SECONDS=60
BOUND_PHONE_REQUESTS_PER_MINUTE=30
BOUND_PHONE_MAX_TRACKED_CLIENTS=10000
