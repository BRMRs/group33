diff --git a/android-app/src/test/kotlin/com/group33/medicationreminder/integration/CaregiverFeedbackRangeInputTest.kt b/android-app/src/test/kotlin/com/group33/medicationreminder/integration/CaregiverFeedbackRangeInputTest.kt
